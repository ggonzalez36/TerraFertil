---
// Métricas
const stats = [
  { value: '$12M+', label: 'Capital gestionado' },
  { value: '1,800+', label: 'Inversores activos' },
  { value: '24', label: 'Proyectos completados' },
  { value: '11.8%', label: 'Rendimiento promedio anual' },
];
---

<section class="bg-verde-700 py-14">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center text-white">
      {stats.map((s) => (
        <div>
          <p class="font-display text-4xl font-bold text-terra-200 mb-1">{s.value}</p>
          <p class="text-verde-200 text-sm">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>