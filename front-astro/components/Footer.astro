          <li><a href="#" class="hover:text-white transition-colors">Cómo funciona</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Rendimientos</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Blog</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-4 text-sm">Empresa</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="#" class="hover:text-white transition-colors">Nosotros</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Equipo</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Prensa</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-4 text-sm">Legal</h4>
