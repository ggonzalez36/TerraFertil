---
// Cómo funciona
const steps = [
  {
    num: '01',
    iconPath: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
    title: 'Crea tu cuenta',
    desc: 'Regístrate en minutos. Verificamos tu identidad de forma segura para proteger tu inversión.',
  },
  {
    num: '02',
    iconPath: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
    title: 'Elige tu proyecto',
    desc: 'Explora proyectos curados con información completa: ubicación, rendimiento esperado, riesgo y plazo.',
  },
  {
    num: '03',
    iconPath: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    title: 'Invierte desde $500',
    desc: 'Selecciona el monto que deseas invertir. Un mínimo accesible para que todos puedan participar.',
  },
  {
    num: '04',
    iconPath: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    title: 'Recibe tus rendimientos',
    desc: 'Seguimiento en tiempo real. Recibes distribuciones periódicas directamente en tu cuenta.',
  },
];
---

<section id="how-it-works" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-base font-semibold text-terra-600 tracking-wide uppercase">Proceso</h2>
      <p class="mt-2 text-3xl font-extrabold text-gray-900 sm:text-4xl">Cómo funciona TerraFértil</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step) => (
        <div class="relative p-6 bg-gray-50 rounded-2xl transition-all hover:shadow-lg">
          <div class="text-terra-200 font-bold text-5xl absolute top-4 right-6 opacity-50">{step.num}</div>
          <div class="w-12 h-12 bg-terra-100 rounded-xl flex items-center justify-center text-terra-600 mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={step.iconPath} />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">{step.title}</h3>
          <p class="text-gray-600">{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>