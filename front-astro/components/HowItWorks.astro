---
// Cómo funciona
const steps = [ 
 { 
   num: '01', 
   icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`, 
   title: 'Crea tu cuenta', 
   desc: 'Regístrate en minutos. Verificamos tu identidad de forma segura para proteger tu inversión.', 
 }, 
 { 
   num: '02', 
   icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />`, 
   title: 'Elige tu proyecto', 
   desc: 'Explora proyectos curados con información completa: ubicación, rendimiento esperado, riesgo y plazo.', 
 }, 
 { 
   num: '03', 
   icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`, 
   title: 'Invierte desde $500', 
   desc: 'Selecciona el monto que deseas invertir. Un mínimo accesible para que todos puedan participar.', 
 }, 
 { 
   num: '04', 
   icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />`, 
   title: 'Recibe tus rendimientos', 
   desc: 'Seguimiento en tiempo real. Recibes distribuciones periódicas directamente en tu cuenta.', 
 }, 
]; 
---
<section id="como-funciona" class="py-24 bg-white"> 
 <div class="max-w-6xl mx-auto px-4 sm:px-6"> 
   <div class="text-center mb-16"> 
     <span class="inline-block bg-tierra-100 text-tierra-700 text-xs font-semibold tracking-widest uppercase px-3 py-1 rounded-full mb-4"> 
       Proceso simple 
     </span> 
     <h2 class="font-display text-3xl sm:text-4xl font-bold text-verde-900 mb-4"> 
       Invierte en 4 pasos 
     </h2> 
     <p class="text-tierra-600 text-lg max-w-xl mx-auto"> 
       Diseñado para que puedas empezar a invertir sin complicaciones, sin importar tu experiencia previa. 
     </p> 
   </div>
   <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8"> 
     {steps.map((step) => ( 
       <div class="relative group"> 
         <div class="bg-terra-50 hover:bg-verde-50 border border-tierra-100 rounded-2xl p-6 h-full transition-colors duration-300"> 
           <div class="flex items-center gap-3 mb-4"> 
             <span class="font-numbers text-5xl font-black text-verde-700 leading-none">{step.num}</span> 
             <div class="w-10 h-10 rounded-xl bg-verde-100 flex items-center justify-center flex-shrink-0"> 
               <svg class="w-5 h-5 text-verde-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" 
                 set:html={step.icon} /> 
             </div> 
           </div> 
           <h3 class="font-semibold text-verde-900 text-lg mb-2">{step.title}</h3> 
           <p class="text-tierra-600 text-sm leading-relaxed">{step.desc}</p> 
         </div> 
       </div> 
     ))} 
   </div> 
 </div> 
</section>
