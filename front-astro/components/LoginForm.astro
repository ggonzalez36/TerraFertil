---
// Componente de formulario de login
---
<div class="min-h-screen bg-gradient-to-br from-terra-50 to-verde-50 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md">
    <!-- Card principal -->
    <div class="bg-white rounded-2xl shadow-xl p-8 border border-tierra-100">
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="flex justify-center mb-4">
          <div class="w-12 h-12 rounded-full bg-verde-600 flex items-center justify-center">
            <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0110.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
            </svg>
          </div>
        </div>
        <h1 class="font-display text-3xl font-bold text-verde-900 mb-2">TerraFertil</h1>
        <p class="text-tierra-600">Ingresa a tu cuenta para invertir</p>
      </div>

  <!-- Formulario -->
  <form id="loginForm" class="space-y-5">
    <!-- Email -->
    <div>
      <label for="email" class="block text-sm font-semibold text-verde-900 mb-2">
        Correo electrónico
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="tu@email.com"
        class="w-full px-4 py-2 border border-tierra-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-verde-500 focus:border-transparent transition"
      />
    </div>

    <!-- Contraseña -->
    <div>
      <label for="password" class="block text-sm font-semibold text-verde-900 mb-2">
        Contraseña
      </label>
      <input
        type="password"
        id="password"
        name="password"
        required
        placeholder="••••••••"
        class="w-full px-4 py-2 border border-tierra-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-verde-500 focus:border-transparent transition"
      />
    </div>

    <!-- Recordar contraseña -->
    <div class="flex items-center justify-between">
      <label class="flex items-center">
        <input
          type="checkbox"
          id="remember"
          name="remember"
          class="w-4 h-4 text-verde-600 border-tierra-300 rounded focus:ring-2 focus:ring-verde-500"
        />
        <span class="ml-2 text-sm text-tierra-600">Recuérdame</span>
      </label>
      <a href="#" class="text-sm text-verde-600 hover:text-verde-700 font-semibold">
        ¿Olvidaste tu contraseña?
      </a>
    </div>

    <!-- Error message -->
    <div id="errorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>

    <!-- Botón de login -->
    <button
      id="loginSubmitBtn"
      type="submit"
      class="w-full bg-verde-600 text-white font-semibold py-3 px-4 rounded-full hover:bg-verde-700 transition-colors"
    >
      Ingresar
    </button>
  </form>

  <!-- Divider -->
  <div class="relative my-6">
    <div class="absolute inset-0 flex items-center">
      <div class="w-full border-t border-tierra-200"></div>
    </div>
    <div class="relative flex justify-center text-sm">
      <span class="px-2 bg-white text-tierra-500">¿No tienes cuenta?</span>
    </div>
  </div>

  <!-- Link de registro -->
  <a
    href="/#lista-espera"
    class="block w-full text-center border-2 border-verde-600 text-verde-700 font-semibold py-2.5 px-4 rounded-full hover:bg-verde-50 transition-colors"
  >
    Únete a la lista de espera
  </a>

  <!-- Footer -->
  <p class="text-center text-xs text-tierra-400 mt-6">
    Al ingresar, aceptas nuestros <a href="#" class="text-verde-600 hover:underline">Términos de Servicio</a> y <a href="#" class="text-verde-600 hover:underline">Política de Privacidad</a>
  </p>
</div>

</div>

</div>

<script>
  const API_BASE_URL = (() => {
    const host = window.location.hostname || 'localhost';
    const protocol = window.location.protocol === 'https:' ? 'https:' : 'http:';
    return `${protocol}//${host}:8080`;
  })();

  const loginForm = document.getElementById('loginForm');
  const errorMessage = document.getElementById('errorMessage');
  const loginSubmitBtn = document.getElementById('loginSubmitBtn');

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const remember = (document.getElementById('remember') as HTMLInputElement).checked;

    errorMessage?.classList.add('hidden');
    
    if(loginSubmitBtn) {
        loginSubmitBtn.textContent = 'Ingresando...';
        loginSubmitBtn.disabled = true;
    }

    try {
      const response = await fetch(`${API_BASE_URL}/api/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password, remember }),
      });



      if (response.ok) {
        const data = await response.json();
        localStorage.setItem('authToken', data.token);
        window.location.href = '/dashboard';
      } else {
        const error = await response.json();
        showError(error.message || 'Credenciales inválidas');
      }
    } catch (error) {
      showError('Error de conexión. Intenta nuevamente.');
    } finally {
        if(loginSubmitBtn) {
            loginSubmitBtn.textContent = 'Ingresar';
            loginSubmitBtn.disabled = false;
        }
    }
  });



  function showError(message: string) {

    if (errorMessage) {

      errorMessage.textContent = message;

      errorMessage.classList.remove('hidden');

    }

  }

</script>

<style>

  input::placeholder {

    color: #cbd5e1;

  }

</style>